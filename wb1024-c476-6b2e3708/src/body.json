"\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\" aria-label=\"漫游旅行票夹首页\">\n      <span class=\"brand-mark\"><i data-lucide=\"route\"></i></span>\n      <span><b>漫游</b><small>ROAM · TRAVEL WALLET</small></span>\n    </a>\n    <div class=\"top-actions\">\n      <span class=\"access-badge\" id=\"accessBadge\">演示版 · 只读</span>\n      <span class=\"save-state\" id=\"saveState\" hidden></span>\n      <button class=\"text-button\" id=\"styleButton\" type=\"button\"><i data-lucide=\"palette\"></i><span>航空票夹</span></button>\n      <details class=\"more-menu\" id=\"moreMenu\">\n        <summary class=\"icon-button\" aria-label=\"更多操作\"><i data-lucide=\"ellipsis\"></i></summary>\n        <div class=\"more-menu-panel\">\n          <button id=\"tripButton\" type=\"button\" data-open-editor=\"trip\" hidden>旅程</button>\n          <button id=\"agentButton\" type=\"button\" data-open-section=\"agent\" hidden>Agent 更新</button>\n          <button id=\"exportButton\" type=\"button\" hidden>导出</button>\n          <button id=\"manifestButton\" type=\"button\" hidden>附件</button>\n          <button id=\"linksButton\" type=\"button\" hidden>分享</button>\n          <button id=\"dataButton\" type=\"button\" hidden>数据</button>\n        </div>\n      </details>\n      <button class=\"icon-button\" id=\"themeButton\" type=\"button\" aria-label=\"切换明暗模式\">\n        <i data-lucide=\"moon\"></i>\n      </button>\n    </div>\n  </header>\n\n  <section class=\"trip-header\" id=\"tripHeader\" hidden>\n    <div class=\"trip-header-inner\">\n      <p class=\"eyebrow\">BOARDING WALLET · YOUR JOURNEY</p>\n      <div class=\"trip-title-row\">\n        <div>\n          <h1 id=\"tripTitle\"></h1>\n          <p id=\"tripMeta\"></p>\n        </div>\n        <div class=\"trip-stamp\" aria-hidden=\"true\"><span>ROUTE</span><b id=\"tripCode\">PEK</b></div>\n      </div>\n      <p class=\"trip-note\" id=\"tripNote\"></p>\n    </div>\n  </section>\n\n  <nav class=\"module-nav\" id=\"moduleNav\" aria-label=\"旅行模块\" hidden>\n    <button data-tab=\"travel\" class=\"active\"><i data-lucide=\"tickets-plane\"></i><span>出行</span></button>\n    <button data-tab=\"itinerary\"><i data-lucide=\"route\"></i><span>行程</span></button>\n    <button data-tab=\"prepare\"><i data-lucide=\"list-checks\"></i><span>准备</span></button>\n    <button data-tab=\"expenses\"><i data-lucide=\"wallet-cards\"></i><span>记账</span></button>\n    <button data-tab=\"materials\"><i data-lucide=\"folder-open\"></i><span>资料</span></button>\n  </nav>\n\n  <main id=\"app\" tabindex=\"-1\">\n    <section class=\"state-view\" id=\"loadingView\">\n      <span class=\"loading-mark\"></span>\n      <h1>正在打开旅行票夹</h1>\n      <p>读取行程、票据和准备事项…</p>\n    </section>\n  </main>\n\n  <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n\n  <div id=\"confirmDialog\" class=\"confirm-overlay\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"confirmDialogTitle\" hidden>\n    <div class=\"confirm-box\">\n      <div class=\"dialog-head\">\n        <div><span class=\"section-kicker\">CONFIRM</span><h2 id=\"confirmDialogTitle\">确认操作</h2></div>\n      </div>\n      <p class=\"dialog-note\" id=\"confirmDialogMessage\"></p>\n      <footer class=\"dialog-footer\">\n        <button class=\"text-button\" id=\"confirmCancel\" type=\"button\">取消</button>\n        <button class=\"text-button primary-action\" id=\"confirmOk\" type=\"button\">确定</button>\n      </footer>\n    </div>\n  </div>\n\n  <dialog id=\"dataDialog\" aria-labelledby=\"dataDialogTitle\">\n    <div class=\"dialog-head\">\n      <div><span class=\"section-kicker\">TRAVELPACK 1.1</span><h2 id=\"dataDialogTitle\">导入与编辑数据</h2></div>\n      <button class=\"icon-button\" id=\"dialogClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <p class=\"dialog-note\">可粘贴 Agent 生成的 TravelPack，或选择 JSON 文件。保存会整份更新旅行数据。</p>\n    <div class=\"dialog-actions\">\n      <label class=\"file-button\">选择 JSON 文件<input id=\"importFile\" type=\"file\" accept=\"application/json,.json\"></label>\n      <button class=\"text-button\" id=\"formatButton\" type=\"button\">格式化</button>\n    </div>\n    <textarea id=\"jsonEditor\" spellcheck=\"false\" aria-label=\"TravelPack JSON\"></textarea>\n    <p class=\"dialog-error\" id=\"dialogError\" role=\"alert\"></p>\n    <footer class=\"dialog-footer\">\n      <button class=\"text-button\" id=\"dialogCancel\" type=\"button\">取消</button>\n      <button class=\"text-button primary-action\" id=\"saveButton\" type=\"button\">保存到云端</button>\n    </footer>\n  </dialog>\n\n  <dialog id=\"attachmentDialog\" aria-labelledby=\"attachmentDialogTitle\">\n    <div class=\"dialog-head\">\n      <div><span class=\"section-kicker\">ATTACHMENTS</span><h2 id=\"attachmentDialogTitle\">上传附件</h2></div>\n      <button class=\"icon-button\" id=\"attachmentDialogClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <p class=\"dialog-note\">从相册选照片或上传 PDF，单个文件不超过 5MB，手机原图会自动压缩。附件会关联到已有资料条目，只有你登录后能查看。</p>\n    <div class=\"attachment-form\">\n      <label>关联资料<select id=\"attachmentMaterial\"></select></label>\n      <label>选择文件<input id=\"attachmentFile\" type=\"file\" accept=\"image/*,application/pdf\"></label>\n    </div>\n    <p class=\"dialog-error\" id=\"attachmentError\" role=\"alert\"></p>\n    <footer class=\"dialog-footer\">\n      <button class=\"text-button\" id=\"attachmentCancel\" type=\"button\">取消</button>\n      <button class=\"text-button primary-action\" id=\"uploadAttachmentButton\" type=\"button\">上传并保存</button>\n    </footer>\n  </dialog>\n\n  <dialog id=\"maintenanceDialog\" class=\"maintenance-dialog\" aria-labelledby=\"maintenanceDialogTitle\">\n    <div class=\"dialog-head\">\n      <div><span class=\"section-kicker\">EDIT</span><h2 id=\"maintenanceDialogTitle\">编辑</h2></div>\n      <button class=\"icon-button\" id=\"maintenanceClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <div class=\"maintenance-body\" id=\"maintenanceBody\"></div>\n    <p class=\"dialog-error\" id=\"maintenanceError\" role=\"alert\"></p>\n    <footer class=\"dialog-footer\">\n      <button class=\"text-button\" id=\"maintenanceCancel\" type=\"button\">关闭</button>\n    </footer>\n  </dialog>\n\n  <dialog id=\"linksDialog\" aria-labelledby=\"linksDialogTitle\">\n    <div class=\"dialog-head\">\n      <div><span class=\"section-kicker\">ACCESS LINKS</span><h2 id=\"linksDialogTitle\">管理访问链接</h2></div>\n      <button class=\"icon-button\" id=\"linksDialogClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <p class=\"dialog-note\">重新生成会让现有编辑链接和只读链接立即失效。新链接只显示在本次操作结果中，请分别保存。</p>\n    <div class=\"link-results\" id=\"linkResults\" hidden>\n      <label>新编辑链接<textarea id=\"newEditLink\" readonly></textarea></label>\n      <button class=\"text-button\" type=\"button\" data-copy-link=\"newEditLink\">复制编辑链接</button>\n      <label>新只读链接<textarea id=\"newReadLink\" readonly></textarea></label>\n      <button class=\"text-button\" type=\"button\" data-copy-link=\"newReadLink\">复制只读链接</button>\n    </div>\n    <p class=\"dialog-error\" id=\"linksError\" role=\"alert\"></p>\n    <footer class=\"dialog-footer\">\n      <button class=\"text-button\" id=\"linksCancel\" type=\"button\">关闭</button>\n      <button class=\"text-button primary-action\" id=\"rotateLinksButton\" type=\"button\">重新生成两条链接</button>\n    </footer>\n  </dialog>\n\n  <dialog id=\"placeDialog\" class=\"place-dialog\" aria-labelledby=\"placeDialogTitle\">\n    <div class=\"dialog-head\">\n      <div><span class=\"section-kicker\" id=\"placeDialogKicker\">PLACE</span><h2 id=\"placeDialogTitle\">地点详情</h2></div>\n      <button class=\"icon-button\" id=\"placeDialogClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <div class=\"dialog-body\" id=\"placeDialogBody\"></div>\n    <footer class=\"dialog-footer\">\n      <button class=\"text-button primary-action\" id=\"placeDialogDone\" type=\"button\">知道了</button>\n    </footer>\n  </dialog>\n\n  <dialog id=\"styleDialog\" class=\"style-dialog\" aria-labelledby=\"styleDialogTitle\">\n    <div class=\"dialog-head\">\n      <div><span class=\"section-kicker\">APPEARANCE</span><h2 id=\"styleDialogTitle\">选择旅行界面风格</h2></div>\n      <button class=\"icon-button\" id=\"styleDialogClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <p class=\"dialog-note\">六种风格共用数据与交互。新增三种方向先审核出行模块。</p>\n    <div class=\"style-options\">\n      <button class=\"style-choice\" type=\"button\" data-style-choice=\"aviation\">\n        <span class=\"style-preview style-preview-aviation\"><b>漫游</b><strong>BOARDING WALLET</strong><i></i><i></i></span>\n        <span><b>航空票夹</b><small>原型基线 · 航空蓝 · 票夹与时间轴</small></span>\n      </button>\n      <button class=\"style-choice\" type=\"button\" data-style-choice=\"natural\">\n        <span class=\"style-preview style-preview-natural\"><b>漫游</b><strong>TRAVEL JOURNAL</strong><i></i><i></i></span>\n        <span><b>自然手账</b><small>暖白 · 鼠尾草绿 · 旅行手账</small></span>\n      </button>\n      <button class=\"style-choice\" type=\"button\" data-style-choice=\"minimal\">\n        <span class=\"style-preview style-preview-minimal\"><b>漫游</b><strong>TRIP OVERVIEW</strong><i></i><i></i></span>\n        <span><b>极简导览</b><small>冷白 · 清晰蓝 · 高信息密度</small></span>\n      </button>\n      <button class=\"style-choice\" type=\"button\" data-style-choice=\"collage\">\n        <span class=\"style-preview style-preview-collage\"><b>漫游</b><strong>切开城市 · 拼出路线</strong><i></i><i></i></span>\n        <span><b>拼贴裁纸</b><small>毛边纸片 · 橙蓝撞色 · 旅行剪报</small></span>\n      </button>\n      <button class=\"style-choice\" type=\"button\" data-style-choice=\"print\">\n        <span class=\"style-preview style-preview-print\"><b>漫游日报</b><strong>ROUTE / 01</strong><i></i><i></i></span>\n        <span><b>印刷风</b><small>套色油墨 · 网点肌理 · 编辑版式</small></span>\n      </button>\n      <button class=\"style-choice\" type=\"button\" data-style-choice=\"urban\">\n        <span class=\"style-preview style-preview-urban\"><b>ROAM / CITY</b><strong>TRANSIT SYSTEM</strong><i></i><i></i></span>\n        <span><b>都市设计</b><small>夜灰 · 荧光绿 · 交通导视</small></span>\n      </button>\n    </div>\n    <footer class=\"dialog-footer\">\n      <span class=\"style-help\">预览选择保存在当前浏览器；Agent 会将你确认的 styleId 写入正式 TravelPack。</span>\n      <button class=\"text-button primary-action\" id=\"styleDialogDone\" type=\"button\">完成选择</button>\n    </footer>\n  </dialog>\n\n  <!-- 内嵌脱敏演示数据：纯静态、免登录、零后端依赖，任何访客打开即可完整体验 -->\n  <script id=\"travelpack-data\" type=\"application/json\">{\n  \"days\": [\n    {\n      \"id\": \"day-04\",\n      \"date\": \"2026-11-04\",\n      \"title\": \"杭州 → 吉隆坡\"\n    },\n    {\n      \"id\": \"day-05\",\n      \"date\": \"2026-11-05\",\n      \"title\": \"吉隆坡老城 · 演出日\"\n    },\n    {\n      \"id\": \"day-06\",\n      \"date\": \"2026-11-06\",\n      \"title\": \"吉隆坡 → 亚庇 · 落地入城\"\n    },\n    {\n      \"id\": \"day-07\",\n      \"date\": \"2026-11-07\",\n      \"title\": \"亚庇 · 天堂岛一日游 + 丝绸港湾日落\"\n    },\n    {\n      \"id\": \"day-08\",\n      \"date\": \"2026-11-08\",\n      \"title\": \"加雅街周日大集 · 红树林萤火虫\"\n    },\n    {\n      \"id\": \"day-09\",\n      \"date\": \"2026-11-09\",\n      \"title\": \"亚庇市区 → 杭州\"\n    }\n  ],\n  \"trip\": {\n    \"id\": \"trip-my-kl-penang-2026-11\",\n    \"note\": \"示例行程 · 数据已脱敏：本作品演示一套「联程票 + 跨境中转 + 双城陆路切换」的完整行程规划方法。去程 11.04 乘国泰 CX965 + CX725 经香港中转（10:40 落地 HKG → 12:45 起飞，中转 2 小时 05 分，同一航站楼 T1 转机、免入境）；11.06 吉隆坡 → 亚庇亚航 AK5133（15:05 从 KLIA 航站楼 2 / klia2 起飞，与国泰落地的 T1 不是同一航站楼，须预留转场时间）；11.09 亚庇 → 杭州亚航 AK1574（14:55 BKI T1 起飞，直飞 4 小时 35 分）。关键提示：沙巴州有独立移民权，飞抵亚庇须走人工柜台办入境并盖沙巴入境章；连续行程务必以承运方官方渠道为准。\",\n    \"title\": \"香港中转 · 马来西亚双城行程规划\",\n    \"endDate\": \"2026-11-09\",\n    \"subtitle\": \"6天5晚 · 香港中转 2 小时 05 分 · 跳岛浮潜 + 红树林萤火虫\",\n    \"startDate\": \"2026-11-04\",\n    \"destination\": \"马来西亚\",\n    \"defaultTimezone\": \"Asia/Kuala_Lumpur\",\n    \"destinationCode\": \"BKI\"\n  },\n  \"stays\": [\n    {\n      \"id\": \"stay-kl\",\n      \"links\": [],\n      \"notes\": \"吉隆坡 2 晚（11.04 入住、11.06 退房），已定温德姆双子塔套房（Wyndham Suites KLCC），两晚合计（金额已脱敏）。位于 KLCC 金三角，步行约 14 分钟到双子塔与城中城公园，去吉隆坡会议中心、柏威年、武吉免登都很近；入住 15:00 后／退房 12:00 前，房费含免费 Wi-Fi 与免费停车。⚠️ 距 KLIA 约 59 公里、车程 55–70 分钟，11.06 赶亚航 AK5133（15:05 起飞，KLIA 航站楼 2 / klia2）要在 11:00 前出发——是去 T2（klia2），别跑 T1。原先「住武吉加里尔以便看演出散场后 2 站回酒店」的取舍已放弃——KLCC 到武吉加里尔体育馆约 20 公里，散场后建议直接叫车（约 RM40–60）或走到 Pavilion Bukit Jalil 再打车。\",\n      \"status\": \"booked\",\n      \"checkIn\": \"2026-11-04\",\n      \"placeId\": \"place-hotel-kl\",\n      \"checkOut\": \"2026-11-06\",\n      \"materialIds\": [\n        \"material-hotel-kl\"\n      ]\n    },\n    {\n      \"id\": \"stay-kk\",\n      \"links\": [],\n      \"notes\": \"亚庇 3 晚连住 Horizon Hotel（Jalan Pantai）不挪窝，行李不用搬。✅ 已订：高级双床房（Superior Twin，2 张单人床）×1 间 ×3 晚，2026-10-06 在线预付（金额已脱敏），订单号（已脱敏），含免费取消。选它的原因：就在 Jalan Pantai 上（11.08 大集入口步行约 150 米）、步行可达哲斯顿码头（11.07 跳岛集合点）、红树林团市区接车范围覆盖、到机场约 8.4 公里／15 分钟。入住 14:00 后／退房 12:00 前，前台可寄存行李；外国游客旅游税 RM10／房／晚，入住时现付；房价不含早餐，楼下就是加雅街餐馆。11 月是雨季淡季，房源宽松；本次已锁可免费取消房价。\",\n      \"status\": \"booked\",\n      \"checkIn\": \"2026-11-06\",\n      \"placeId\": \"place-hotel-kk\",\n      \"checkOut\": \"2026-11-09\",\n      \"materialIds\": [\n        \"material-hotel-kk\"\n      ]\n    }\n  ],\n  \"tasks\": [\n    {\n      \"id\": \"task-book-flight-outbound\",\n      \"kind\": \"booking\",\n      \"dueAt\": {\n        \"timezone\": \"Asia/Shanghai\",\n        \"localDate\": \"2026-09-27\",\n        \"localTime\": \"20:00\",\n        \"precision\": \"minute\"\n      },\n      \"notes\": \"已出票（2026-10-12 出票，预订编号（已脱敏））国泰联程 CX965（杭州 HGH T4 08:00 → 香港 HKG T1 10:40）+ CX725（香港 12:45 → 吉隆坡 KUL T1 16:50），11.04 周三，香港中转 2 小时 05 分。Economy Light（O 级，票价基础（已脱敏））含 1×23kg 托运 + 7kg 手提 + 两段各一顿正餐（CX965 早餐、CX725 中餐）；行李直挂吉隆坡、香港不用取、不用入境。实付金额（已脱敏）（含税及承运人附加费），比原计划的厦航直飞（约 ¥1,900／人）省约 ¥940／人。⚠️ 必须同一张联程票；⚠️ 落地比原计划晚 2 小时 10 分，11.04 晚间行程已整体重排。\",\n      \"title\": \"已订去程：11.04 国泰 CX965+CX725 杭州 → 香港 → 吉隆坡\",\n      \"status\": \"